# CodeBuddy Agent SDK 配置（复制本文件为 .env 后按需填写）

# 方式一：API Key（推荐用于服务端）
# 获取地址：https://www.codebuddy.cn/profile/keys
# 若本机已通过 codebuddy 命令登录，可留空，SDK 会自动使用登录凭据
CODEBUDDY_API_KEY=

# 版本环境：internal=中国版（默认）；external=海外版；ioa=iOA 企业版；cloudhosted=专享版；selfhosted=私有化
CODEBUDDY_INTERNET_ENVIRONMENT=internal

# 可选，指定模型，留空使用默认模型。示例：deepseek-v3.1
CODEBUDDY_MODEL=

# 可选，CodeBuddy CLI 可执行文件路径；留空时 SDK 会自动查找
CODEBUDDY_CODE_PATH=

# 服务端口
PORT=3000
